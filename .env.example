# CoinPoker live harness environment. All values are optional; CLI flags win.
# Loaded by the operator's shell (not by the binary itself).

# --- VLM (Laya vision server) -------------------------------------------------
# Full route, exactly as validated: loopback port 18090, /v1/laya/predict.
# Do NOT append a second route; the value must already end in /v1/laya/predict.
COINPOKER_VLM_ENDPOINT=http://127.0.0.1:18090/v1/laya/predict
COINPOKER_VLM_MODEL=coinpoker-laya-vision
# Optional bounds
#COINPOKER_VLM_TIMEOUT_SECS=5
#COINPOKER_LAYA_THRESHOLD=0.9

# --- CDP (Electron client, lobby surface) -------------------------------------
# CoinPoker must be launched with --remote-debugging-port=<this port>.
COINPOKER_CDP_PORT=9222
# Set to 0 to disable the CDP lobby poller entirely.
COINPOKER_CDP=1

# --- Replay determinism --------------------------------------------------------
# When set, decision-affecting RNG (equity sampling, sizing jitter) is seeded.
# Leave unset for production realism.
#COINPOKER_SEED=42
