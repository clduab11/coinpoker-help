# coinpoker-help environment variables
# Copy this file to .env and adjust values as needed.
# .env is gitignored — do not commit local configuration.

# Window-title substring used for capture selection (macOS ScreenCaptureKit)
COINPOKER_WINDOW_TITLE=CoinPoker

# Owning-application substring used as a fallback capture match
COINPOKER_APP_NAME=CoinPoker

# Chat-completions endpoint used in capture mode (OpenAI-compatible)
# Default: local Gemma 4 MLX server
COINPOKER_VLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions

# Model name sent to the VLM server
# Must match the model loaded by the VLM server
COINPOKER_VLM_MODEL=gemma-4-e2b-it-OptiQ-4bit

# Set to "1" or "true" to permit a non-loopback HTTPS endpoint
# WARNING: enables sending screenshots to remote hosts — only use with
# a trusted service, suitable authentication, and a reviewed retention policy.
# COINPOKER_ALLOW_REMOTE_VLM=