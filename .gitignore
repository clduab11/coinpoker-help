# Rust build output
/target/

# Downloaded MLX model repositories. Keep root-level model documentation and
# manifests trackable; downloaded repository directories remain ignored by
# models/.gitignore.
/models/*
!/models/.gitignore
!/models/README.md
!/models/*.md
!/models/*.json
!/models/*.toml

# Local environment and secrets
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
