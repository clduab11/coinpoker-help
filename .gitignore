# Rust build output
/target/

# Downloaded model and runtime assets. Keep root-level model documentation and
# manifests trackable; downloaded binaries remain ignored by models/.gitignore.
/models/*
!/models/.gitignore
!/models/README.md
!/models/*.md
!/models/*.json
!/models/*.toml

# Local environment and secrets
.env
.env.*
!.env.example

# Private evaluation images, reports, calibrated identities and local runtimes
/.local/
.venv/
venv/
/dist/
# Scratch output from packaging dry-runs and other temp work
cpk-dryrun/
__pycache__/
*.pyc

# Editor / OS noise
*.swp
.idea/
.vscode/
