# Rust build output
/target/

# Downloaded model and runtime assets. Keep root-level model documentation and
# manifests trackable; downloaded binaries remain ignored by models/.gitignore.
/models/*
!/models/.gitignore
!/models/README.md
!/models/*.md
!/models/*.json
!/models/*.toml

# Local environment and secrets
.env
.env.*
!.env.example

# Private evaluation images, reports, calibrated identities and local runtimes
/.local/
/.conda/
/lobby-screengrab.png
.venv/
venv/
/dist/
# Scratch output from packaging dry-runs and other temp work
cpk-dryrun/
__pycache__/
*.pyc
.pytest_cache/

# Tool output (regenerable): graphify cache and dated run snapshots.
# graph.json / GRAPH_REPORT.md / manifest.json / labels stay trackable.
graphify-out/cache/
graphify-out/20*/

# Editor / OS noise
/.claude/
*.swp
.idea/
.vscode/
